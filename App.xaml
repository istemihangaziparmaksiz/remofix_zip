<Application x:Class="RemofixZip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- ========================================================================= -->
            <!-- OBSIDIAN CARBON & MODERN PALETTE                                          -->
            <!-- ========================================================================= -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#09090B" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0C0C0E" />
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1C1C21" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111114" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#222228" />
            <SolidColorBrush x:Key="SubCardBackgroundBrush" Color="#16161A" />
            <SolidColorBrush x:Key="SubCardBorderBrush" Color="#27272E" />

            <!-- Primary High-Contrast Monochromatic Buttons -->
            <SolidColorBrush x:Key="PrimaryBtnBg" Color="#F4F4F5" />
            <SolidColorBrush x:Key="PrimaryBtnHoverBg" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryBtnPressedBg" Color="#D4D4D8" />
            <SolidColorBrush x:Key="PrimaryBtnText" Color="#09090B" />

            <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#059669" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

            <!-- Secondary Actions -->
            <SolidColorBrush x:Key="SecondaryActionBtnBg" Color="#18181C" />
            <SolidColorBrush x:Key="SecondaryActionBtnHoverBg" Color="#232329" />
            <SolidColorBrush x:Key="SecondaryActionBtnBorder" Color="#2C2C35" />
            <SolidColorBrush x:Key="SecondaryActionBtnText" Color="#E4E4E7" />

            <!-- Status Colors -->
            <SolidColorBrush x:Key="StatusSuccessBg" Color="#052E16" />
            <SolidColorBrush x:Key="StatusSuccessBorder" Color="#065F46" />
            <SolidColorBrush x:Key="StatusSuccessText" Color="#34D399" />

            <SolidColorBrush x:Key="StatusDangerBg" Color="#2A0A0E" />
            <SolidColorBrush x:Key="StatusDangerBorder" Color="#7F1D1D" />
            <SolidColorBrush x:Key="StatusDangerText" Color="#F87171" />

            <SolidColorBrush x:Key="StatusWarningBg" Color="#291503" />
            <SolidColorBrush x:Key="StatusWarningBorder" Color="#78350F" />
            <SolidColorBrush x:Key="StatusWarningText" Color="#FBBF24" />

            <SolidColorBrush x:Key="StatusInfoBg" Color="#082F49" />
            <SolidColorBrush x:Key="StatusInfoBorder" Color="#0369A1" />
            <SolidColorBrush x:Key="StatusInfoText" Color="#38BDF8" />

            <!-- ========================================================================= -->
            <!-- VECTOR GEOMETRIES (Lucide / Precision Stroke)                              -->
            <!-- ========================================================================= -->
            <Geometry x:Key="GeoSearch">M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M21 21l-4.35-4.35</Geometry>
            <Geometry x:Key="GeoLayers">M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5</Geometry>
            <Geometry x:Key="GeoCpu">M4 4h16v16H4z M9 9h6v6H9z M9 1v3 M15 1v3 M9 20v3 M15 20v3 M20 9h3 M20 14h3 M1 9h3 M1 14h3</Geometry>
            <Geometry x:Key="GeoDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</Geometry>
            <Geometry x:Key="GeoLink">M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71</Geometry>
            <Geometry x:Key="GeoFolder">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z</Geometry>
            <Geometry x:Key="GeoFolderOpen">M2 9v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-7l-2-2H4a2 2 0 0 0-2 2z</Geometry>
            <Geometry x:Key="GeoFile">M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z M13 2v7h7</Geometry>
            <Geometry x:Key="GeoLock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z M7 11V7a5 5 0 0 1 10 0v4</Geometry>
            <Geometry x:Key="GeoGlobe">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M2 12h20 M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z</Geometry>
            <Geometry x:Key="GeoRefresh">M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16 M16 16h5v5</Geometry>
            <Geometry x:Key="GeoArrowLeft">M19 12H5 M12 19l-7-7 7-7</Geometry>
            <Geometry x:Key="GeoArrowRight">M5 12h14 M12 5l7 7-7 7</Geometry>
            <Geometry x:Key="GeoHome">M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</Geometry>
            <Geometry x:Key="GeoCheck">M20 6L9 17l-5-5</Geometry>
            <Geometry x:Key="GeoClose">M18 6L6 18 M6 6l12 12</Geometry>
            <Geometry x:Key="GeoFolderCheck">M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z M9 14l2 2 4-4</Geometry>
            <Geometry x:Key="GeoTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</Geometry>

            <!-- ========================================================================= -->
            <!-- CARD & BUTTON STYLES                                                      -->
            <!-- ========================================================================= -->
            <Style x:Key="ModernCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PrimaryBtnBg}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnText}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBtnHoverBg}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBtnPressedBg}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubCardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SuccessActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#059669" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#10B981" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#10B981" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#047857" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubCardBackgroundBrush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SecondaryActionBtnBg}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryActionBtnText}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryActionBtnBorder}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryActionBtnHoverBg}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubCardBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar Nav RadioButton -->
            <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    CornerRadius="7"
                                    Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="activeIndicator"
                                            Grid.Column="0"
                                            Width="3"
                                            Height="16"
                                            CornerRadius="1.5"
                                            Margin="-6,0,8,0"
                                            Background="{DynamicResource TextPrimaryBrush}"
                                            Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubCardBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SubCardBackgroundBrush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SubCardBorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Custom TreeView Style -->
            <Style x:Key="ModernTreeViewItemStyle" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        BorderBrush="Transparent"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid Margin="{Binding Converter={x:Null}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="19" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander"
                                                      Style="{DynamicResource ModernTreeToggleStyle}"
                                                      IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press" />
                                        <ContentPresenter x:Name="PART_Header"
                                                          Grid.Column="1"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost"
                                                Grid.Row="1"
                                                Margin="18,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="false">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" SourceName="Bd" Value="true">
                                    <Setter TargetName="Bd" Property="Background" Value="#141418" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="Bd" Property="Background" Value="#1E1E24" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2E2E38" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="false">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernTreeToggleStyle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="16" Height="16">
                                <Path x:Name="ExpandPath"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Data="M6 4l4 4-4 4"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ExpandPath" Property="Data" Value="M4 6l4 4 4-4" />
                                    <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ExpandPath" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
