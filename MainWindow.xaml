<Window x:Class="RemofixZip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:RemofixZip.Converters"
        xmlns:models="clr-namespace:RemofixZip.Models"
        mc:Ignorable="d"
        Title="Remofix Zip"
        Icon="Assets/app.ico"
        Height="850" Width="1380"
        MinHeight="720" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA"
        ui:TitleBar.InactiveBackground="#09090B"
        ui:TitleBar.InactiveForeground="#71717A">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sol Kenar Çubuğu -->
            <ColumnDefinition Width="268" />
            <!-- Ana Çalışma Alanı -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- SOL KENAR ÇUBUĞU (SIDEBAR)                                -->
        <!-- ========================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Marka Başlığı -->
                <Grid Grid.Row="0" Margin="2,0,2,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E4E4E7"
                            BorderThickness="1"
                            Padding="4">
                        <Image Source="Assets/R.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Remofix Zip"
                                   FontWeight="Bold"
                                   FontSize="16.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="REMOTE ARCHIVE INSPECTOR"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- İnce Ayırıcı Çizgi -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="0,0,0,18" />

                <!-- Navigasyon Modülleri -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="MODÜLLER"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="8,0,0,8" />

                    <!-- 1. ZIP Gezgini -->
                    <RadioButton x:Name="rbNavExplorer"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 IsChecked="True"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLayers}"
                                  Width="16" Height="16"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                            <TextBlock Text="ZIP Gezgini" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 2. Dahili Web Tarayıcı -->
                    <RadioButton x:Name="rbNavBrowser"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoGlobe}"
                                  Width="16" Height="16"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                            <TextBlock Text="Dahili Tarayıcı" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 3. İndirme Yöneticisi -->
                    <RadioButton x:Name="rbNavDownloads"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource GeoDownload}"
                                  Width="16" Height="16"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="İndirmeler" VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    x:Name="badgeActiveDownloads"
                                    Background="#10B981"
                                    CornerRadius="10"
                                    Padding="6,1"
                                    Margin="4,0,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txtBadgeCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <!-- 4. Ayarlar -->
                    <RadioButton x:Name="rbNavSettings"
                                 Style="{DynamicResource SidebarNavButtonStyle}"
                                 Checked="NavButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCpu}"
                                  Width="16" Height="16"
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />
                            <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Alt Durum Rozeti -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SubCardBackgroundBrush}"
                        BorderBrush="{DynamicResource SubCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,8,0" />
                            <TextBlock Text="Range İndirici Aktif" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="HTTP 206 Partial Content • ZIP64"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="15,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- ANA ÇALIŞMA ALANI                                         -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="24,20,24,20">

            <!-- 1. GÖRÜNÜM: ZIP GEZGİNİ -->
            <Grid x:Name="panelExplorer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- URL Girdi Barı Kartı -->
                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- URL Girişi -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="txtUrl"
                                     Height="40"
                                     FontSize="13"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource SubCardBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource SubCardBorderBrush}"
                                     BorderThickness="1"
                                     ui:ControlHelper.PlaceholderText="İncelenecek ZIP dosyasının doğrudan URL bağlantısını yapıştırın (https://.../dosya.zip)"
                                     GotFocus="TxtUrl_GotFocus"
                                     PreviewMouseLeftButtonDown="TxtUrl_PreviewMouseLeftButtonDown"
                                     KeyDown="TxtUrl_KeyDown" />
                        </Grid>

                        <!-- Yapıştır Butonu -->
                        <Button Grid.Column="1"
                                Content="Yapıştır"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="BtnPaste_Click" />

                        <!-- İncele Butonu -->
                        <Button Grid.Column="2"
                                x:Name="btnAnalyze"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Height="40"
                                Width="140"
                                Click="BtnAnalyze_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing x:Name="ringAnalyze" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed" IsActive="False" />
                                <Path x:Name="icoAnalyze" Data="{StaticResource GeoSearch}" Stroke="#09090B" StrokeThickness="1.8" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="İçeriği Tara" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Arşiv Özet Bilgi Kartı (Analiz sonrası görünür) -->
                <Border Grid.Row="1"
                        x:Name="cardArchiveSummary"
                        Style="{StaticResource ModernCardStyle}"
                        Padding="16,12"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoFolderCheck}" Stroke="#34D399" StrokeThickness="1.8" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="lblArchiveName" Text="archive.zip" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border x:Name="badgeEncrypted" Background="#291503" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoLock}" Stroke="#FBBF24" StrokeThickness="1.8" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Şifreli Arşiv" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="lblArchiveSize" Text="Boyut: 0 MB" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock x:Name="lblArchiveCount" Text="0 Dosya, 0 Klasör" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="• HTTP Range (206 Partial Content) Doğrulandı" FontSize="12" Foreground="#34D399" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Hızlı Seçim Butonları -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Tümünü Seç" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0" Click="BtnSelectAll_Click" />
                            <Button Content="Temizle" Style="{StaticResource SecondaryActionButtonStyle}" Click="BtnDeselectAll_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Merkez: Klasör Ağacı (TreeView) -->
                <Border Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="14">
                    <Grid>
                        <!-- Başlangıç Boş Durum Bilgisi -->
                        <StackPanel x:Name="panelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                            <Border Width="64" Height="64" CornerRadius="12" Background="#141418" BorderBrush="#24242B" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="{StaticResource GeoLayers}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="İçerik Görüntülemek İçin Bir ZIP URL'si Girin" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Dosyanın tamamını indirmeden içindeki dosyaları listeleyip tek tek seçerek indirebilirsiniz."
                                       FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- TreeView Ağaç Görünümü -->
                        <TreeView x:Name="treeArchive"
                                  Visibility="Collapsed"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource ModernTreeViewItemStyle}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type models:ZipTreeNode}" ItemsSource="{Binding Children}">
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Seçim Onay Kutusu -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Checked="TreeNode_CheckChanged"
                                                  Unchecked="TreeNode_CheckChanged" />

                                        <!-- Klasör / Dosya İkonu -->
                                        <Path Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Width="16" Height="16"
                                              StrokeThickness="1.6">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource GeoFile}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource GeoFolder}" />
                                                            <Setter Property="Stroke" Value="#F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <!-- İsim & Alt Bilgi -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="{Binding IsDirectory, Converter={x:Null}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding SubtitleInfo, StringFormat=' ({0})'}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- Sağ Taraf: Sıkıştırma Oranı Rozeti -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,4,0">
                                            <Border Background="#18181C" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                    Visibility="{Binding Item.CompressionRatioText, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding Item.CompressionRatioText}" FontSize="10" Foreground="#34D399" />
                                            </Border>
                                            <TextBlock Text="{Binding DisplaySize}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Alt İşlem Çubuğu -->
                <Border Grid.Row="3" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Seçim Özeti -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="lblSelectedSummary" Text="Seçilen dosya yok" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="lblStatusLog" Text="" FontSize="12" Foreground="#38BDF8" Margin="20,0,0,0" />
                        </StackPanel>

                        <!-- İndir Butonu -->
                        <Button Grid.Column="1"
                                x:Name="btnDownloadSelected"
                                Content="Seçilenleri İndir"
                                Style="{StaticResource SuccessActionButtonStyle}"
                                Height="42"
                                Width="180"
                                IsEnabled="False"
                                Click="BtnDownloadSelected_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. GÖRÜNÜM: DAHİLİ WEB TARAYICI -->
            <Grid x:Name="panelBrowser" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tarayıcı Üst Çubuğu -->
                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigasyon Butonları -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}" Width="36" Height="36" Padding="0" Margin="0,0,6,0" Click="BtnBrowserBack_Click">
                                <Path Data="{StaticResource GeoArrowLeft}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SecondaryActionButtonStyle}" Width="36" Height="36" Padding="0" Margin="0,0,6,0" Click="BtnBrowserForward_Click">
                                <Path Data="{StaticResource GeoArrowRight}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SecondaryActionButtonStyle}" Width="36" Height="36" Padding="0" Margin="0,0,6,0" Click="BtnBrowserRefresh_Click">
                                <Path Data="{StaticResource GeoRefresh}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource SecondaryActionButtonStyle}" Width="36" Height="36" Padding="0" Click="BtnBrowserHome_Click">
                                <Path Data="{StaticResource GeoHome}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- URL Giriş Alanı -->
                        <TextBox Grid.Column="1"
                                 x:Name="txtBrowserUrl"
                                 Height="36"
                                 FontSize="13"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SubCardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource SubCardBorderBrush}"
                                 BorderThickness="1"
                                 GotFocus="TxtBrowserUrl_GotFocus"
                                 PreviewMouseLeftButtonDown="TxtBrowserUrl_PreviewMouseLeftButtonDown"
                                 KeyDown="TxtBrowserUrl_KeyDown" />

                        <!-- Git Butonu -->
                        <Button Grid.Column="2"
                                Content="Git"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Height="36"
                                Width="70"
                                Margin="10,0,0,0"
                                Click="BtnBrowserGo_Click" />
                    </Grid>
                </Border>

                <!-- WebView2 Gömülü Tarayıcı Alanı -->
                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="0" ClipToBounds="True">
                    <wv2:WebView2 x:Name="wvBrowser" />
                </Border>
            </Grid>

            <!-- 3. GÖRÜNÜM: İNDİRME YÖNETİCİSİ -->
            <Grid x:Name="panelDownloads" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- İndirme Üst Bilgi Kartı -->
                <Border Grid.Row="0" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İndirme Kuyruğu &amp; Geçmişi" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Parçalı HTTP Range indirme kanalları üzerinden indirilen dosyalar." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="İndirilenler Klasörünü Aç" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,10,0" Click="BtnOpenDownloadFolder_Click" />
                            <Button Content="Bitenleri Temizle" Style="{StaticResource SecondaryActionButtonStyle}" Click="BtnClearFinishedDownloads_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Görev Kartları Listesi -->
                <Border Grid.Row="1" Style="{StaticResource ModernCardStyle}" Padding="14">
                    <Grid>
                        <TextBlock x:Name="txtNoDownloads"
                                   Text="Henüz bir indirme görevi başlatılmadı."
                                   FontSize="13.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="listDownloads">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DownloadTaskItem}">
                                        <Border Background="{DynamicResource SubCardBackgroundBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Üst Satır: Dosya Adı ve Durum -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Durum Rozeti -->
                                                    <Border Grid.Column="1"
                                                            Background="{Binding StatusBadgeBackground}"
                                                            CornerRadius="4"
                                                            Padding="8,3"
                                                            Margin="10,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}" />
                                                    </Border>

                                                    <!-- İptal / Klasör Butonları -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Klasörde Göster"
                                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                                FontSize="11.5"
                                                                Padding="10,4"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnShowInFolder_Click"
                                                                Tag="{Binding LocalDestinationPath}" />
                                                        <Button Content="İptal"
                                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                                FontSize="11.5"
                                                                Padding="10,4"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                                Click="BtnCancelDownload_Click"
                                                                Tag="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Orta Satır: İlerleme Çubuğu -->
                                                <ProgressBar Grid.Row="1"
                                                             Height="6"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding Progress}"
                                                             Foreground="#10B981"
                                                             Background="#1C1C22"
                                                             BorderThickness="0"
                                                             Margin="0,0,0,8" />

                                                <!-- Alt Satır: Boyut, Hız ve Yüzde Bilgisi -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding DownloadedSizeText, Mode=OneWay}" />
                                                        <Run Text=" / " />
                                                        <Run Text="{Binding TotalSizeText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,16,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. GÖRÜNÜM: AYARLAR -->
            <Grid x:Name="panelSettings" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Uygulama Ayarları" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="İndirme motoru ve ağ bağlantı parametrelerini yapılandırın." FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" />

                        <!-- İndirme Kanalları Kartı -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Eşzamanlı İndirme Kanalı (Multi-Threading)" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="HTTP Range üzerinden büyük dosyaların bölünerek indirileceği kanal sayısı." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="cbThreads" Width="120" Height="36" VerticalAlignment="Center" SelectionChanged="CbThreads_SelectionChanged">
                                    <ComboBoxItem Content="1 Kanal (Tekil)" Tag="1" />
                                    <ComboBoxItem Content="2 Kanal" Tag="2" />
                                    <ComboBoxItem Content="4 Kanal (Varsayılan)" Tag="4" IsSelected="True" />
                                    <ComboBoxItem Content="8 Kanal (Hızlı)" Tag="8" />
                                    <ComboBoxItem Content="16 Kanal (Maks)" Tag="16" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- İndirme Konumu Kartı -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Varsayılan İndirme Klasörü" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="İndirilen dosyalar program klasöründeki remofix_zip_download altına arşiv adıyla kaydedilir." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="txtDownloadDir"
                                             Height="38"
                                             FontSize="12"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             IsReadOnly="True"
                                             Background="{DynamicResource SubCardBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource SubCardBorderBrush}" />
                                    <Button Grid.Column="1"
                                            Content="Klasörü Aç"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Height="38"
                                            Margin="10,0,0,0"
                                            Click="BtnOpenDownloadFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hakkında Kartı -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Remofix Zip Hakkında" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Versiyon 1.0.0 Pro • 2026 Remofix Suite" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,10" />
                                <TextBlock Text="İnternet üzerindeki büyük ZIP arşivlerinin tamamını indirmeye gerek duymadan, yalnızca Central Directory yapısını okuyarak içerisindeki seçilen dosyaları HTTP Range (206) teknolojisiyle çeker."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
