<Window x:Class="RemofixZip.Dialogs.ConfirmPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="ZIP Dosyası Tespit Edildi"
        Width="460" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">

    <Border Padding="24" Background="{DynamicResource CardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="6" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="{StaticResource GeoDownload}" Stroke="#34D399" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ZIP Dosyası Tespit Edildi" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Dahili tarayıcıda bir indirme bağlantısı yakalandı." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- İçerik -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="lblMessage"
                           Text="Bu dosya incelensin mi?"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="lblUrl"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Butonlar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Vazgeç" Style="{StaticResource SecondaryActionButtonStyle}" Width="90" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click" />
                <Button Content="İncele" Style="{StaticResource SuccessActionButtonStyle}" Width="110" Height="36" Click="BtnConfirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
