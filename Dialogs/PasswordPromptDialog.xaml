<Window x:Class="RemofixZip.Dialogs.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Şifreli ZIP Arşivi"
        Width="440" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="#09090B"
        ui:TitleBar.Foreground="#FAFAFA">

    <Border Padding="24" Background="{DynamicResource CardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="34" Height="34" CornerRadius="6" Background="#2A1B0E" BorderBrush="#78350F" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="{StaticResource GeoLock}" Stroke="#F59E0B" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Arşiv Parolası Gerekiyor" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Bu ZIP dosyasındaki içerikler şifrelenmiştir." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Parola bu oturum boyunca bu link için hatırlanacaktır." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

            <!-- Parola Alanı -->
            <PasswordBox Grid.Row="2" x:Name="txtPassword"
                         Height="38"
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource SubCardBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource SubCardBorderBrush}"
                         BorderThickness="1"
                         KeyDown="TxtPassword_KeyDown" />

            <!-- Butonlar -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="İptal" Style="{StaticResource SecondaryActionButtonStyle}" Width="90" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click" />
                <Button Content="Uygula" Style="{StaticResource PrimaryActionButtonStyle}" Width="110" Height="36" Click="BtnApply_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
