<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>RemofixZip</AssemblyName>
    <TargetName>RemofixZip</TargetName>
    <Product>Remofix Zip</Product>
    <Title>Remofix Zip</Title>
    <Company>Remofix</Company>
    <Description>Remote Zip Inspector and Selective Downloader</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\R.png" />
    <Resource Include="Assets\R_white_bg.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

</Project>